#!/bin/sh
# WanPilot device backend integration candidate (not installed). Never apply on install.
set -e
BASE=/etc/wanpilot/v11
SHARED_LOCK=/var/lock/wanpilot-shared-mwan3.lock
LOCK=/var/lock/wanpilot-v11.lock
LIVE=/etc/config/mwan3
GUARD=$BASE/pending
TOKEN=$BASE/token
STATE=$BASE/state
BACKUP=$BASE/mwan3.original
CANDIDATE=$BASE/mwan3.candidate
READY=$BASE/ready
PID=$BASE/watchdog.pid
LOG=$BASE/recovery.log
SOURCE=/etc/config/wanpilot
SOURCE_SHA=$BASE/wanpilot.sha
STAGER=/usr/libexec/wanpilot-stage
STAGED=/tmp/wanpilot-v10-stage/config/mwan3
mkdir -p "$BASE" /var/lock
chmod 700 "$BASE"
sha() { sha256sum "$1" | awk '{print $1}'; }
die() { echo "ERROR: $*" >&2; exit 1; }
locked() { flock -x 8 || die 'Cannot obtain shared mwan3 lock'; flock -x 9 || die 'Cannot obtain application lock'; }
check_tools() {
 for cmd in flock sha256sum nohup uci awk cp mv; do command -v "$cmd" >/dev/null 2>&1 || die "Missing command: $cmd"; done
 [ -x /etc/init.d/mwan3 ] || die 'mwan3 service not present'
 [ -x "$STAGER" ] || die 'Stage generator not installed'
 [ -f "$LIVE" ] || die 'mwan3 config missing'
 [ "$(uci -q get wanpilot.main.enabled)" = 0 ] || die 'Keep legacy write permission disabled'
 [ -z "$(uci -q changes mwan3)" ] || die 'Pending mwan3 UCI edits'
 [ -z "$(uci -q changes wanpilot)" ] || die 'Pending WanPilot UCI edits'
 [ ! -f /etc/wanpilot/pending ] || die 'Legacy WanPilot change pending'
 [ ! -e /etc/wanpilot/global-safe-v19/pending ] || die 'Global balanced application pending'
 # Existing managed sections are checked by the isolated stager; no blanket refusal.
}
# Revalidate candidate preservation at BOTH check and apply time.
# All UCI reads are confined to independent directories and isolated delta paths.
verify_preserved() {
 # Clear every derived view, including the count-check view, before each validation.
 rm -rf "$BASE/verify-original" "$BASE/verify-candidate" "$BASE/config" "$BASE/delta"
 mkdir -p "$BASE/verify-original/config" "$BASE/verify-original/delta" "$BASE/verify-candidate/config" "$BASE/verify-candidate/delta" "$BASE/config" "$BASE/delta"
 cp "$CANDIDATE" "$BASE/config/mwan3"
 cp "$BACKUP" "$BASE/verify-original/config/mwan3"
 cp "$CANDIDATE" "$BASE/verify-candidate/config/mwan3"
 [ -z "$(command uci -c "$BASE/verify-original/config" -P "$BASE/verify-original/delta" -q changes mwan3)" ] || die 'Original verification delta not empty'
 [ -z "$(command uci -c "$BASE/verify-candidate/config" -P "$BASE/verify-candidate/delta" -q changes mwan3)" ] || die 'Candidate verification delta not empty'
 command uci -c "$BASE/verify-original/config" -P "$BASE/verify-original/delta" show mwan3 |
   sed '/^mwan3\.wpx_[abpr]_[A-Za-z0-9_]*[.=]/d' | LC_ALL=C sort > "$BASE/verify-original.fields"
 command uci -c "$BASE/verify-candidate/config" -P "$BASE/verify-candidate/delta" show mwan3 |
   sed '/^mwan3\.wpx_[abpr]_[A-Za-z0-9_]*[.=]/d' | LC_ALL=C sort > "$BASE/verify-candidate.fields"
 cmp -s "$BASE/verify-original.fields" "$BASE/verify-candidate.fields" || die 'Candidate changes protected global or non-device fields'
 # Catch missing/duplicate generated rule positions and invalid candidate policy wiring.
 command uci -c "$BASE/verify-candidate/config" -P "$BASE/verify-candidate/delta" show mwan3 > "$BASE/verify-candidate.all"
 awk -F'[.=]' '
   /^mwan3\.[A-Za-z0-9_]+=[A-Za-z0-9_]+$/ {
     if ($2 == "default_rule_v4") default_position = NR
     if ($2 ~ /^wpx_r_/) { if (first_rule == 0) first_rule = NR; if (NR > last_rule) last_rule = NR; count++ }
   }
   END { if (!count || !default_position || last_rule >= default_position) exit 1 }
 ' "$BASE/verify-candidate.all" || die 'Candidate device rule order invalid'
 # Validate every generated device rule references an existing policy, and
 # each managed policy member actually exists and is a member section.
 awk -F'[.=]' '
   /^mwan3\.[A-Za-z0-9_]+=[A-Za-z0-9_]+$/ { section[$2]=$3; next }
   /^mwan3\.wpx_r_[A-Za-z0-9_]+\.use_policy=/ {
     v=$0; sub(/^[^=]*=/,"",v); gsub(/\047/,"",v); rule_policy[$2]=v; next
   }
   /^mwan3\.wpx_p_[A-Za-z0-9_]+\.use_member=/ {
     v=$0; sub(/^[^=]*=/,"",v); n=split(v,a,/ +/);
     for(i=1;i<=n;i++){gsub(/\047/,"",a[i]); if(a[i]!="") policy_member[$2 SUBSEP a[i]]=1}
   }
   END {
     rules=0
     for (r in rule_policy) { rules++; if(section[r]!="rule" || section[rule_policy[r]]!="policy") exit 1 }
     if(rules==0) exit 1
     for (key in policy_member) {
       split(key,p,SUBSEP)
       if(section[p[1]]!="policy" || section[p[2]]!="member") exit 1
     }
     for(r in rule_policy){p=rule_policy[r]; found=0; for(key in policy_member){split(key,a,SUBSEP); if(a[1]==p)found=1}; if(!found)exit 1}
   }
 ' "$BASE/verify-candidate.all" || die 'Candidate device policy/member references invalid'
}
check_candidate() {
 [ -f "$CANDIDATE" ] && [ -f "$BACKUP" ] || die 'Missing candidate or backup'
 [ -f "$SOURCE_SHA" ] && [ -f "$SOURCE" ] || die 'WanPilot configuration fingerprint missing'
 [ "$(sha "$SOURCE")" = "$(cat "$SOURCE_SHA")" ] || die 'WanPilot rules changed since readiness check; run check again'
 [ "$(sha "$LIVE")" = "$(sha "$BACKUP")" ] || die 'Live mwan3 changed after snapshot'
 [ "$(sha "$CANDIDATE")" = "$(cat "$BASE/candidate.sha")" ] || die 'Candidate modified after stage'
 [ "$(sha "$BACKUP")" = "$(cat "$BASE/original.sha")" ] || die 'Backup modified after stage'
 verify_preserved
 count="$(command uci -c "$BASE/config" -P "$BASE/delta" show mwan3 | grep -Ec '^mwan3\.wpx_r_[A-Za-z0-9_]+=rule$' || :)"
 [ "$count" -gt 0 ] || die 'No enabled managed rules: refuse no-op application'
 # Fail closed when saved WanPilot device rules and persisted candidate disagree.
 [ -f /tmp/wanpilot-v10-stage/expected-rules.sorted ] || die 'Missing expected rule manifest'
 command uci -c "$BASE/config" -P "$BASE/delta" show mwan3 |
   sed -n 's/^mwan3\.\(wpx_r_[A-Za-z0-9_]*\)=rule$/\1/p' | LC_ALL=C sort > "$BASE/candidate-rules.sorted"
 cmp -s /tmp/wanpilot-v10-stage/expected-rules.sorted "$BASE/candidate-rules.sorted" || die 'Candidate rule set does not match enabled WanPilot rules'
 [ "$count" = "$(wc -l < /tmp/wanpilot-v10-stage/expected-rules.sorted | tr -d ' ')" ] || die 'Candidate rule count disagrees with WanPilot'
}
check() {
 locked
 [ ! -e "$GUARD" ] || die 'An application is awaiting confirmation'
 [ ! -e /etc/wanpilot/global-safe-v19/pending ] || die 'Global balanced application pending'
 check_tools
 "$STAGER" || die 'Candidate generation failed'
 [ -f "$STAGED" ] || die 'Staged candidate absent'
 # Avoid creating a new test from a stale candidate if config changed during staging.
 live_before="$(sha "$LIVE")"
 source_before="$(sha "$SOURCE")"
 [ -f /tmp/wanpilot-v10-stage/original.uci ] || die 'Missing staged audit output'
 cp "$LIVE" "$BASE/original.new"
 cp "$STAGED" "$BASE/candidate.new"
 chmod 600 "$BASE/original.new" "$BASE/candidate.new"
 [ "$live_before" = "$(sha "$LIVE")" ] || die 'Live config changed during snapshot'
 [ "$source_before" = "$(sha "$SOURCE")" ] || die 'WanPilot rules changed during snapshot'
 mv "$BASE/original.new" "$BACKUP"
 mv "$BASE/candidate.new" "$CANDIDATE"
 sha "$BACKUP" > "$BASE/original.sha"
 sha "$CANDIDATE" > "$BASE/candidate.sha"
 echo "$source_before" > "$SOURCE_SHA"
 # Candidate view is always rebuilt by verify_preserved() on each check.
 check_candidate
 printf 'READY PASS: candidate and backup verified; %s enabled rules.\n' "$count"
 echo "Original SHA256: $(cat "$BASE/original.sha")"
 echo "Candidate SHA256: $(cat "$BASE/candidate.sha")"
 echo "WanPilot SHA256: $(cat "$SOURCE_SHA")"
 echo 'No mwan3 changes or service restarts.'
}
restore_locked() {
 # Never overwrite changes made by another editor after candidate activation.
 # A matching original means restoration already happened and is harmless.
 # A candidate mismatch means automatic recovery would destroy unrelated data.
 current_live_sha="$(sha "$LIVE")" || { echo restore_failed_live_read > "$STATE"; return 1; }
 if [ "$current_live_sha" != "$(cat "$BASE/candidate.sha" 2>/dev/null)" ] &&
    [ "$current_live_sha" != "$(cat "$BASE/original.sha" 2>/dev/null)" ]; then
    echo restore_conflict_external_edit > "$STATE"
    echo 'RESTORE BLOCKED: live mwan3 differs from both candidate and original; manual intervention required' >> "$LOG"
    return 1
 fi
 [ -f "$BACKUP" ] && [ -f "$BASE/original.sha" ] || { echo 'RESTORE ERROR: backup missing' >> "$LOG"; echo restore_failed_backup > "$STATE"; return 1; }
 [ "$(sha "$BACKUP")" = "$(cat "$BASE/original.sha")" ] || { echo 'RESTORE ERROR: backup SHA mismatch' >> "$LOG"; echo restore_failed_backup_hash > "$STATE"; return 1; }
 if [ -n "$(uci -q changes mwan3)" ]; then
    echo restore_blocked_uci_edits > "$STATE"
    echo 'RESTORE BLOCKED: active mwan3 UCI edits; refusing to replace config while editor has pending changes' >> "$LOG"
    return 1
 fi
 # If the original file is already back, a repeated watchdog/rollback must not
 # restart WAN again. The transaction can be closed without touching the network.
 if [ "$current_live_sha" = "$(cat "$BASE/original.sha")" ]; then
    rm -f "$GUARD" "$TOKEN"
    echo restored > "$STATE"
    echo 'RESTORE VERIFIED: original already present; no service restart' >> "$LOG"
    return 0
 fi
 cp "$BACKUP" "$LIVE.recover.$$" || { echo restore_failed_copy > "$STATE"; return 1; }
 chmod 600 "$LIVE.recover.$$"
 mv "$LIVE.recover.$$" "$LIVE" || { echo restore_failed_move > "$STATE"; return 1; }
 # Never revert the user's whole UCI staging area: a concurrent editor may own it.
 result=0
 /etc/init.d/mwan3 restart >> "$LOG" 2>&1 || result=1
 [ "$(sha "$LIVE")" = "$(cat "$BASE/original.sha")" ] || result=1
 if [ "$result" -eq 0 ]; then
    rm -f "$GUARD" "$TOKEN"
    echo restored > "$STATE"
    echo 'RESTORE VERIFIED: original config hash matched and mwan3 restarted' >> "$LOG"
 else
    echo restore_failed_service_or_hash > "$STATE"
    echo 'ALERT: restored file, but service/hash validation failed' >> "$LOG"
    return 1
 fi
}
watchdog() {
 tok="$2"
 echo "$tok" > "$READY"
 sleep 120
 ( locked
   [ -f "$GUARD" ] || exit 0
   [ -f "$TOKEN" ] || exit 0
   [ "$(cat "$TOKEN")" = "$tok" ] || exit 0
   restore_locked >> "$LOG" 2>&1 || :
 ) 8>"$SHARED_LOCK" 9>"$LOCK"
}
apply() {
 # Real apply must have an actual candidate change; no-op must not restart WAN.
 locked
 [ ! -f "$GUARD" ] || die 'Application pending'
 [ ! -e /etc/wanpilot/global-safe-v19/pending ] || die 'Global application pending'
 check_tools
 check_candidate
 [ "$(cat "$BASE/candidate.sha")" != "$(cat "$BASE/original.sha")" ] || die 'No configuration changes; apply refused to avoid needless mwan3 restart'
 [ -z "$(uci -q changes mwan3)" ] || die 'Pending mwan3 UCI edits'
 [ -z "$(uci -q changes wanpilot)" ] || die 'Pending WanPilot UCI edits'
 rm -f "$READY"
 tok="$(date +%s)-$$"
 echo "$tok" > "$TOKEN"
 : > "$GUARD"
 echo arming > "$STATE"
 nohup /bin/sh "$0" watchdog "$tok" </dev/null >> "$LOG" 2>&1 8>&- 9>&- &
 echo "$!" > "$PID"
 ok=0
 i=0
 while [ "$i" -lt 6 ]; do
   if [ -f "$READY" ] && [ "$(cat "$READY")" = "$tok" ] && kill -0 "$(cat "$PID")" 2>/dev/null; then ok=1; break; fi
   i=$((i+1)); sleep 1
 done
 if [ "$ok" -ne 1 ]; then rm -f "$GUARD" "$TOKEN"; echo arming_failed > "$STATE"; die 'Watchdog not ready; live config unchanged'; fi
 # Recheck that WAN config was not altered while waiting for watchdog.
 # Before any candidate write, cancel rather than schedule a restore that could
 # overwrite a concurrent edit made while the watchdog was being armed.
 if [ "$(sha "$LIVE")" != "$(cat "$BASE/original.sha")" ]; then
   rm -f "$GUARD" "$TOKEN"
   echo arming_cancelled_live_changed > "$STATE"
   die 'Live mwan3 changed during arming; no candidate written'
 fi
 if [ "$(sha "$SOURCE")" != "$(cat "$SOURCE_SHA")" ]; then
   rm -f "$GUARD" "$TOKEN"
   echo arming_cancelled_source_changed > "$STATE"
   die 'WanPilot rules changed during watchdog arming; no live write'
 fi
 # A different UCI editor is not governed by WanPilot's shared flock.
 # Abort BEFORE any write instead of allowing the watchdog to overwrite it later.
 if [ -n "$(uci -q changes mwan3)" ] || [ -n "$(uci -q changes wanpilot)" ]; then
   rm -f "$GUARD" "$TOKEN"
   echo arming_cancelled_uci_edits > "$STATE"
   die 'UCI delta changed during arming; no candidate written'
 fi
 echo pending > "$STATE"
 cp "$CANDIDATE" "$LIVE.install.$$" || die 'copy failed; watchdog armed'
 chmod 600 "$LIVE.install.$$"
 mv "$LIVE.install.$$" "$LIVE" || die 'move failed; watchdog armed'
 if [ -n "$(uci -q changes mwan3)" ]; then
   echo 'ERROR: unexpected pending mwan3 edits after installation; watchdog remains armed' >> "$LOG"
   die 'Unexpected pending UCI changes; refusing restart'
 fi
 if ! /etc/init.d/mwan3 restart >> "$LOG" 2>&1; then echo pending_restart_failed > "$STATE"; die 'mwan3 restart failed; watchdog remains armed'; fi
 echo 'PENDING: confirm within 120 seconds or automatic restore'
}
confirm() {
 locked
 [ -f "$GUARD" ] || die 'No pending application'
 [ -z "$(uci -q changes mwan3)" ] || die 'Cannot confirm with pending mwan3 edits'
 [ -z "$(uci -q changes wanpilot)" ] || die 'Cannot confirm with pending WanPilot edits'
 [ "$(sha "$SOURCE")" = "$(cat "$SOURCE_SHA")" ] || die 'WanPilot rules changed; cannot confirm'
 [ "$(sha "$LIVE")" = "$(cat "$BASE/candidate.sha")" ] || die 'Live candidate changed; cannot confirm'
 kill -0 "$(cat "$PID")" 2>/dev/null || die 'Watchdog unavailable; cannot confirm'
 rm -f "$GUARD" "$TOKEN"
 echo confirmed > "$STATE"
 echo 'CONFIRMED: candidate retained'
}
rollback() { locked; [ -f "$GUARD" ] || die 'No pending application'; restore_locked; cat "$STATE"; }
status() {
 echo "state=$(cat "$STATE" 2>/dev/null || echo never_started)"
 if [ -f "$GUARD" ]; then
   echo 'pending=yes'
   if [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; then echo 'watchdog=process_present'; else echo 'watchdog=NOT_RUNNING'; fi
 else echo 'pending=no'; fi
 if [ -f "$BASE/original.sha" ]; then echo "original_sha=$(cat "$BASE/original.sha")"; fi
 if [ -f "$BASE/candidate.sha" ]; then echo "candidate_sha=$(cat "$BASE/candidate.sha")"; fi
 echo "live_sha=$(sha "$LIVE")"
 if [ -f "$SOURCE_SHA" ]; then echo "wanpilot_snapshot_sha=$(cat "$SOURCE_SHA")"; echo "wanpilot_live_sha=$(sha "$SOURCE")"; fi
 if [ -f "$LOG" ]; then
   echo 'recovery_log_last_event:'
   tail -n 1 "$LOG"
 fi
}
case "${1:-}" in
 check) (check) 8>"$SHARED_LOCK" 9>"$LOCK";;
 status) (locked; status) 8>"$SHARED_LOCK" 9>"$LOCK";;
 watchdog) watchdog "$@";;
 apply) (apply) 8>"$SHARED_LOCK" 9>"$LOCK";;
 confirm) (confirm) 8>"$SHARED_LOCK" 9>"$LOCK";;
 rollback) (rollback) 8>"$SHARED_LOCK" 9>"$LOCK";;
 *) echo 'WanPilot V1.2: use the LuCI read-only checks'; exit 2;;
esac
